{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "cat STATE.md 2>/dev/null || echo 'STATE.md missing — recreate it per CLAUDE.md session-continuity contract'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": ".claude/hooks/stop-state-check.sh" }
        ]
      }
    ]
  }
}
