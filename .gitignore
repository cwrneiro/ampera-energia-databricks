# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node / React (app frontend)
node_modules/
dist/
build/
.vite/
*.local

# Databricks
.databricks/
.databricks-login.json

# Data (never commit raw/working data pulls)
data/
*.csv
# ...except the committed seed of client portfolios (spec 17)
!src/seed/*.csv
*.parquet
*.xlsx

# OS / editor
.DS_Store
.idea/
.vscode/

# Claude Code runtime state
.claude/*.lock

# Impeccable transient artifacts (screenshots, decision-page logs)
.impeccable/review/
.impeccable/questions/
.impeccable/mocks/

# Isaac Review output
.isaac/

# Workspace bundle overlay (targets/dev.yml) and its Genie payload; targets/dev.yml.example is the template
targets/*.yml
targets/*.geniespace.json

# Local agent working files: session handoff note and workspace-specific agent instructions
STATE.md
CLAUDE.local.md
