# Customer environment overlay — the authoritative list of environment-specific values.
#
# Fill it one of three ways (all reach the same file):
#   1. By hand:      cp targets/customer.yml.example targets/<target>.yml, then follow SETUP.md
#   2. Any agent:    ask it to walk you through SETUP.md (AGENTS.md tells it how)
#   3. Claude Code:  /setup  (interactive interview over SETUP.md)
#
# Additive: this adds a new bundle target next to any existing one; it changes no other config.
# Deploy with: databricks bundle deploy -t <target> --profile <profile>
# Rename `customer` below to your target name (it must match the file name you chose).

targets:
  customer:
    # ── Deploy ────────────────────────────────────────────────────────────────────────────
    workspace:
      # Workspace URL. Discover: databricks auth profiles   (host column of your profile)
      host: https://<your-workspace>.cloud.databricks.com
    variables:
      # UC catalog for the medallion; must exist with schemas ampera_bronze/silver/gold/gold_lb (SETUP §2).
      # Discover: databricks catalogs list --profile <profile>
      catalog: <catalog>
      # Lakebase Autoscaling project the app reads (SETUP §4).
      # Discover: databricks postgres list-projects --profile <profile>
      lakebase_project: ampera-demo
      # SQL warehouse the Genie space runs on.
      # Discover: databricks warehouses list --profile <profile>
      warehouse_id: <warehouse-id>
      # Synced-table pipeline ids — only known after SETUP §6 creates the synced tables.
      # Discover: databricks postgres get-synced-table synced_tables/<catalog>.ampera_gold_lb.<table> -o json | jq -r .status.pipeline_id
      sync_pipeline_generation_daily: <pipeline-id>
      sync_pipeline_plant_location: <pipeline-id>
      sync_pipeline_reconciliation_monthly: <pipeline-id>
      sync_pipeline_reconciliation_ai_review: <pipeline-id>
      sync_pipeline_curtailment_daily: <pipeline-id>

    resources:
      genie_spaces:
        ampera_genie:
          # Copy of resources/genie/ampera.geniespace.json with your catalog name (SETUP §3).
          file_path: customer.geniespace.json
          # ── Operate: who can use the Genie space (CAN_RUN = ask questions)
          permissions:
            - group_name: <users-group>
              level: CAN_RUN

      apps:
        ampera_app:
          # ── Operate: who can open the app. Discover groups: databricks groups list --profile <profile>
          permissions:
            - group_name: <users-group>
              level: CAN_USE

      jobs:
        ampera_refresh:
          # ── Operate: refresh cadence (Quartz cron, local time zone) and failure alerts
          schedule:
            quartz_cron_expression: "0 0 6 * * ?"
            timezone_id: America/Sao_Paulo
            pause_status: PAUSED          # UNPAUSED once data landing is automated (SETUP §8)
          email_notifications:
            on_failure:
              - <ops-team@your-company.com>
