# dev overlay template — every workspace-specific value of the bundle.
# cp targets/dev.yml.example targets/dev.yml (gitignored), fill each <…>, then follow README "Reproduce".

targets:
  dev:
    default: true
    workspace:
      # Workspace URL. Discover: databricks auth profiles   (host column of your profile)
      host: https://<your-workspace>.cloud.databricks.com
    variables:
      # Existing UC catalog you can create schemas in; scripts/bootstrap_workspace.sh creates
      # ampera_bronze / ampera_silver / ampera_gold / ampera_gold_lb in it.
      # Discover: databricks catalogs list --profile <profile>
      catalog: <catalog>
      # SQL warehouse for the Genie space and the bootstrap DDL.
      # Discover: databricks warehouses list --profile <profile>
      warehouse_id: <warehouse-id>
      # Synced-table pipeline ids: printed by scripts/run_first_refresh.sh (create_synced_tables.sh).
      # Leave the placeholders until then.
      sync_pipeline_generation_daily: <pipeline-id>
      sync_pipeline_plant_location: <pipeline-id>
      sync_pipeline_reconciliation_monthly: <pipeline-id>
      sync_pipeline_reconciliation_ai_review: <pipeline-id>
      sync_pipeline_curtailment_daily: <pipeline-id>
      sync_pipeline_curtailment_narrative: <pipeline-id>
      sync_pipeline_client_plant_access: <pipeline-id>
      # Who acts for each client (spec 17): user emails or service principal application ids. Optional.
      # client_access: '{"Ventos do Nordeste Participações": ["<sp-application-id>"]}'
    resources:
      genie_spaces:
        ampera_genie:
          # Copy of resources/genie/ampera.geniespace.json with this catalog (deploy_and_refresh.sh writes it)
          file_path: dev.geniespace.json
